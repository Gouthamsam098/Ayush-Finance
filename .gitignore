# ───────────────────────────────────────────────────────────────
# Dependencies
# ───────────────────────────────────────────────────────────────
node_modules/

# ───────────────────────────────────────────────────────────────
# Environment & secrets — NEVER commit
# Frontend VITE_* vars are inlined into the public bundle and are therefore
# NOT secrets, but env files are still per-machine config: keep them local and
# commit only the .example templates.
# ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
secrets/

# ───────────────────────────────────────────────────────────────
# Build output & caches — regenerated by `npm run build`, never reviewed
# ───────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
coverage/

# ───────────────────────────────────────────────────────────────
# Logs
# ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───────────────────────────────────────────────────────────────
# Editor / OS noise
# ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# ───────────────────────────────────────────────────────────────
# Local scratch: generated reports, screenshots, agent run logs.
# Customer ledger PDFs contain real borrower data — they must never be
# committed to source control.
# ───────────────────────────────────────────────────────────────
*.pdf
Screenshot*.png
Screenshot*.jpg
.sisyphus/
.claude/settings.local.json

# Generated customer-facing documents. Named by the builders in
# src/lib/pdfReport.ts, which prefix the borrower's name — so these carry real
# personal data even when the extension is not .pdf.
*Statement-*
*Overdue-Notice-*
Ledger-*

# Report exports (Reports page CSV/PDF). Real portfolio data.
anush-*.csv
anush-*.pdf
Anush-*.pdf

# Throwaway verification scripts run at the repo root to check money math on
# the console. A root-level *.cjs / *.mjs is never app code here — the app is
# TypeScript under src/ and the configs are *.config.ts. If a real .cjs config
# is ever added, re-allow it with a `!` line.
/*.cjs
/*.mjs

# Unrelated vendored project (was committed as a broken gitlink with no
# .gitmodules entry, which breaks a fresh `git clone`).
orbit/

# Local MCP server config and Playwright run artifacts (screenshots, snapshots,
# console logs). Machine-specific: never part of the app.
.mcp.json
.playwright-mcp/
