# ─────────────────────────────────────────────────────────────
# Anush LMS Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# Server
APP_ENV=development           # development | staging | production
PORT=4000
LOG_LEVEL=info                # debug | info | warn | error

# CORS — comma-separated allowed origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://anush_admin:CHANGE_ME@localhost:5432/anush_lms?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h

# JWT — RS256 key file paths (generate with `make keys`)
# Keys live outside the repo; only paths are configured here.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# Hard session model: the access token is the whole session. When it expires
# the user must log in again. Set JWT_REFRESH_TTL=0 to disable silent renewal.
JWT_ACCESS_TTL=1h             # session length; re-login required after this
JWT_REFRESH_TTL=0             # 0 = refresh disabled (no silent extension)
JWT_ISSUER=anush-lms

# Password hashing
BCRYPT_COST=12                # OWASP-recommended minimum for financial systems

# Rate limiting (requests per minute per IP on auth endpoints)
AUTH_RATE_LIMIT_PER_MINUTE=10
# Authenticated API traffic, per client IP. Much larger than the auth limit:
# one page render fires dozens of calls and a whole office can share one IP.
# Caps scraping/enumeration of customer and KYC data. 0 disables.
API_RATE_LIMIT_PER_MINUTE=600
