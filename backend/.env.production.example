# ──────────────────────────────────────────────────────────────────────────
# Anush LMS — PRODUCTION environment template
#
#   cp .env.production.example .env.production   &&   fill in EVERY value
#
# `.env.production` is git-ignored and must NEVER be committed.
# Do not copy any value from docker-compose.yml (the dev file): those
# credentials are public — they are in the repository and its history.
#
# Deploy:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Every var marked REQUIRED is enforced by `${VAR:?}` in the compose file —
# a missing value aborts the deploy instead of silently falling back to a dev
# default.
# ──────────────────────────────────────────────────────────────────────────

# ── Public hostname & TLS (REQUIRED) ──────────────────────────────────────
# The domain must already have an A/AAAA record pointing at this droplet, or
# Let's Encrypt validation fails.
DOMAIN=lms.example.com
ACME_EMAIL=ops@example.com

# ── Database (REQUIRED) ───────────────────────────────────────────────────
# Generate the password, never invent one by hand:
#   openssl rand -base64 32
POSTGRES_DB=anush_lms
POSTGRES_USER=anush_admin
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_base64_32

DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=2

# ── CORS (REQUIRED) ───────────────────────────────────────────────────────
# Must be the exact scheme+host the browser loads, comma-separated for several.
# A wildcard here is REJECTED at boot when APP_ENV=production.
CORS_ALLOWED_ORIGINS=https://lms.example.com

# ── Session / crypto ──────────────────────────────────────────────────────
# Hard session model: the access token IS the session. At expiry the user must
# log in again (there is no silent refresh). Keep JWT_REFRESH_TTL=0 unless
# refresh has been deliberately implemented and reviewed.
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=0
JWT_ISSUER=anush-lms
BCRYPT_COST=12

# Per-IP request cap on auth endpoints.
# NOTE: as of this writing the value is loaded by config but the limiter
# middleware is NOT yet wired in the router — until that is done, login is
# unthrottled. Track this before going live with real customer data.
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Bootstrap admin (FIRST BOOT ONLY) ─────────────────────────────────────
# Set these once so the first admin exists, then DELETE them from this file and
# redeploy. Change the password from inside the app immediately after login.
# Generate:  openssl rand -base64 24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME_openssl_rand_base64_24
ADMIN_FULL_NAME=System Administrator

# ── Runtime ───────────────────────────────────────────────────────────────
# Loan/collection dates are local-calendar based. Keep the containers on IST or
# "today" will shift during UTC-evening hours and dated receipts will be wrong.
TZ=Asia/Kolkata
LOG_LEVEL=info
