# ──────────────────────────────────────────────────────────────────────────
# Frontend environment template.
#
#   cp .env.example .env.local        (git-ignored, per-machine)
#
# IMPORTANT: every VITE_* value is inlined into the JavaScript bundle at build
# time and is therefore PUBLIC. Never put a password, API key, token, or any
# other secret in this file — readers of your site can read all of it.
# ──────────────────────────────────────────────────────────────────────────

# Data source. true = talk to the Go backend; false/unset = in-memory mock data
# (starts EMPTY and resets on reload — for UI work without a backend). There is
# no demo dataset: this is a production finance app, so nothing is fabricated.
VITE_USE_API=true

# API base path used by the browser. Leave as the same-origin default in
# production: the reverse proxy (Caddy) forwards /api to the backend, which
# avoids cross-origin requests entirely.
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target — used ONLY by `npm run dev` (see vite.config.ts).
# Ignored in production builds.
VITE_API_URL=http://localhost:4000

# Optional public URL embedded in WhatsApp payment-request messages from
# Collections → View Report → Share. Defaults to the current site origin.
# VITE_STATEMENT_PORTAL_URL=https://your-production-domain.com
